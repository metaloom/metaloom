# Custom Cortex worker image — the Java daemon from this example.
#
# It builds ON TOP of the official metaloom/cortex-server image, so it inherits the
# full native runtime (Java 25, the OpenCV 5.1 libraries, the InspireFace model pack)
# AND the complete stock worker classpath (cortex-cli.jar, a shaded uber-jar). All
# this thin layer adds is the example's OWN classes (CortexCustomMain + its Dagger
# graph) and the custom node (HelloWorldNode) — a few tens of KB, not a fresh copy
# of every dependency. The stock classpath is reused at runtime via -cp below.
#
# The build context is a staging dir that build-image.sh fills with the two thin
# jars; run ./build-image.sh (it packages, stages and builds in one step).
FROM metaloom/cortex-server:latest

# The example's own thin jar (CortexCustomMain + generated Dagger component) and the
# custom node jar (HelloWorldNode). Everything else comes from /cortex/cortex-cli.jar.
ADD --chown=1000:0 cortex-custom.jar /cortex/custom/cortex-custom.jar
ADD --chown=1000:0 cortex-custom-node.jar /cortex/custom/cortex-custom-node.jar

# CortexCustomMain runs the daemon directly (there is no picocli "server start"
# subcommand as on the stock image). The classpath puts the example's classes first,
# then the stock uber-jar for cortex-core, the pipeline engine and every built-in node.
CMD [ "/opt/java25/bin/java", \
      "-Djna.tmpdir=/tmp/.jna", \
      "-Duser.dir=/cortex", \
      "-Dlogback.configurationFile=/cortex/logback.xml", \
      "--enable-native-access=ALL-UNNAMED", \
      "-cp", "/cortex/custom/cortex-custom.jar:/cortex/custom/cortex-custom-node.jar:/cortex/cortex-cli.jar", \
      "io.metaloom.cortex.cli.CortexCustomMain" ]
