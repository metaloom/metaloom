<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-depthmap-node</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex-nodes</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <name>MetaLoom // Cortex :: Nodes :: Depth Map</name>

    <!--
      The depthmap node is a pure-Java HTTP client for the FastAPI /v1/depth sidecar
      (see sidecars/depth). Image handling is plain ImageIO/Graphics2D (DepthImages),
      so the node stays free of the OpenCV native runtime the video4j-backed nodes
      need. JsonObject comes transitively from cortex-core-media.
    -->

</project>
