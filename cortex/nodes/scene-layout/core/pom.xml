<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-scene-layout-node</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex-nodes</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <name>MetaLoom // Cortex :: Nodes :: Scene Layout</name>

    <!--
      The scene-layout node has no model and no sidecar: it is pure geometry and
      statistics over bounding boxes and a depth map. The depth PNG is read with plain
      ImageIO, so no native runtime is needed. JsonObject comes transitively from
      cortex-core-media.

      It deliberately does NOT depend on cortex-depthmap-node - it consumes that node's
      outputs by key through the pipeline, not by type, which is also what keeps it
      detector-agnostic.
    -->

</project>
