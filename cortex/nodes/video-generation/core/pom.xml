<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-video-generation-node</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex-nodes</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <name>MetaLoom // Cortex :: Nodes :: Video Generation</name>

    <!--
      The videogen node is a pure-Java HTTP client for the FastAPI LTX-2 video
      sidecar (see sidecars/ltx2-sidecar). Like the imagegen node it needs no
      native binding: the (optional) source image is encoded via the JDK ImageIO,
      the produced MP4 bytes are written straight to a local cache, JsonObject
      comes transitively from cortex-core-media, and HashUtils/SHA512 from
      cortex-api.
    -->

</project>
