<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-script-node</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex-nodes</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <name>MetaLoom // Cortex :: Nodes :: Script</name>

    <properties>
        <!--
          GraalVM polyglot. Pinned deliberately rather than floated: a Truffle language and its
          polyglot API must come from the same release, and the pair is what the node's sandbox
          guarantees rest on.

          On a stock (non-GraalVM) JDK the engine runs on Truffle's fallback interpreter with no
          runtime compilation - it logs a warning to that effect, which the engine suppresses.
          That is acceptable because this node runs glue logic, not hot loops.
        -->
        <graalvm.polyglot.version>25.0.0</graalvm.polyglot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.polyglot.version}</version>
        </dependency>
        <!-- Community JS language + its Truffle runtime. Type pom: it is a dependency bundle. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <version>${graalvm.polyglot.version}</version>
            <type>pom</type>
        </dependency>
    </dependencies>

</project>
