<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-voiceprint-node</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex-nodes</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <name>MetaLoom // Cortex :: Nodes :: Voiceprint</name>

    <!--
      The voiceprint node is a pure-Java HTTP client for the FastAPI /v1/voiceprints sidecar
      (see sidecars/voiceprint). It needs no native binding: video is demuxed to a 16 kHz WAV by
      the ffmpeg binary on PATH (the watermark node's precedent), JsonObject comes transitively
      from cortex-core-media.
    -->

</project>
