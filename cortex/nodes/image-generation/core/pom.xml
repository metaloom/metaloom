<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-image-generation-node</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex-nodes</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <name>MetaLoom // Cortex :: Nodes :: Image Generation</name>

    <!--
      The imagegen node is a pure-Java HTTP client for the FastAPI image sidecar
      (see sidecars/ideogram-sidecar). It needs no native binding: the source
      image is loaded and the PNG is encoded via the JDK ImageIO, JsonObject
      comes transitively from cortex-core-media, and HashUtils/SHA512 from
      cortex-api.
    -->

</project>
