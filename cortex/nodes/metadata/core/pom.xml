<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>cortex-metadata-node</artifactId>
	<packaging>jar</packaging>

	<parent>
		<groupId>io.metaloom.cortex</groupId>
		<artifactId>cortex-metadata</artifactId>
		<relativePath>../pom.xml</relativePath>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<name>MetaLoom // Cortex :: Nodes :: Metadata</name>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.metaloom</groupId>
				<artifactId>bom</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Container and document metadata: PDF Info, OOXML/ODF properties, ID3, MP4 ilst. -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-parsers-standard-package</artifactId>
			<exclusions>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
		</dependency>
		<!--
		  Used directly rather than through Tika for images. Tika's ImageMetadataExtractor merges
		  EXIF, IPTC and XMP into one flat namespace and applies its own precedence on the way, which
		  is exactly the information this node's precedence rules need to keep apart.
		 -->
		<dependency>
			<groupId>com.drewnoakes</groupId>
			<artifactId>metadata-extractor</artifactId>
		</dependency>
		<!-- Standalone .xmp sidecars, which no image reader covers. -->
		<dependency>
			<groupId>com.adobe.xmp</groupId>
			<artifactId>xmpcore</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  Publishes the test jar so the integration test can reuse ExifJpegFixture. Writing a
			  second EXIF encoder over there would be two encoders to keep correct, and the one that
			  is only exercised by a single test is the one that silently rots.
			 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
