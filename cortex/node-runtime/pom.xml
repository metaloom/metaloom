<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cortex-node-runtime</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>io.metaloom.cortex</groupId>
        <artifactId>cortex</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <name>MetaLoom // Cortex :: Node Runtime</name>

    <description>
        Executes node tasks handed down by the Loom-side pipeline engine.

        This is the reduced form of the old in-Cortex DAG executor: it runs a SET of
        nodes over one media item, where the set has size 1 today and becomes an
        affinity segment later. Cortex no longer decides what runs next - it only
        answers "run this node on this file".
    </description>

    <dependencies>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-pipeline-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-common</artifactId>
        </dependency>
        <!-- The shared wire contract. Both sides depend on it; neither depends on
             the other. -->
        <dependency>
            <groupId>io.metaloom.loom.shared</groupId>
            <artifactId>loom-pipeline-model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test only: reuses StubLoomMedia and AbstractPipelineNode so the runner
             can be exercised against real node plumbing rather than hand-rolled
             stubs of a wide interface. -->
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-pipeline-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-pipeline-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
