FROM debian:trixie-slim

ENV LOOM_HOST=loom
ENV LOOM_PORT=8092
ENV CORTEX_MONITORING_PORT=8093

ENV HOME=/cortex
ENV JAVA_TOOL_OPTIONS="-Xms256m -Xmx512m"

EXPOSE 8093

USER root

# CUDA runtime (from NVIDIA debian13 repo)
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget ca-certificates && \
    wget -qO /tmp/cuda-keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends cuda-cudart-13-2 libcublas-13-2 && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/cuda-13.2/bin:${PATH}"

# OpenCV runtime dependencies.
#
# The OpenCV libraries themselves are NOT installed from apt. The libopencv_ffm.so
# bundled in the opencv-ffm jar is linked against OpenCV 5.1 (soname .so.501), while
# Debian Trixie ships 4.10 - installing the distro packages produced an image that
# died on startup with:
#   UnsatisfiedLinkError: libopencv_video.so.501: cannot open shared object file
# The 5.1 libraries are staged into the build context by build-container.sh and
# copied in below. What apt provides here is only what OpenCV links *against*:
# ffmpeg, which OpenCV's videoio backend needs.
#
# adduser is listed explicitly: it used to arrive transitively via the libopencv
# packages, and dropping those broke the user-creation step below.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    adduser \
    libavcodec61 \
    libavformat61 \
    libavutil59 \
    libswscale8 \
    libswresample5 && \
    rm -rf /var/lib/apt/lists/*

# OpenCV 5.1 shared libraries, staged by build-container.sh from a local OpenCV
# build (see cortex/container/build-container.sh for how to point at one).
ADD ./cortex/container/target/opencv-libs /opt/opencv/lib
ENV LD_LIBRARY_PATH="/opt/opencv/lib"

WORKDIR  /opt

# JAVA
RUN wget "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.2%2B10/OpenJDK25U-jre_x64_linux_hotspot_25.0.2_10.tar.gz"
RUN tar -xzf *.gz -C /opt && \
    rm *.gz && \
    ln -s /opt/jdk-25.0.2+10-jre /opt/java25

ENV JAVA_HOME=/opt/java25

# Inspireface
WORKDIR  /cortex
RUN mkdir packs && cd packs && wget "https://github.com/HyperInspire/InspireFace/releases/download/v1.x/Pikachu"

# Cortex
RUN adduser --disabled-password --uid 1000 --ingroup root --home /cortex --gecos "" cortex && \
    mkdir /config && chown 1000:0 /config -R && chmod 770 /config && ln -s /config /cortex/config && \
    chown 1000:0 /cortex -R && \
    chmod 770 /cortex -R
ADD --chown=1000:0 ./cortex/container/target/cortex-cli/cortex-cli.jar /cortex/cortex-cli.jar
ADD --chown=1000:0 ./cortex/container/logback.xml /cortex/logback.xml

USER cortex
WORKDIR /cortex
VOLUME /config
VOLUME /meta

CMD [ "/opt/java25/bin/java", "-Djna.tmpdir=/tmp/.jna", "-Duser.dir=/cortex", "-Dlogback.configurationFile=/cortex/logback.xml", "--enable-native-access=ALL-UNNAMED", "-jar", "cortex-cli.jar"]
