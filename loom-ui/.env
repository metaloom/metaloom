# Base URL of the Loom REST API (without trailing slash). Leave unset for a production build:
# the app then derives it from window.location.origin at runtime, so the same build works
# behind any hostname/port it's actually served from. Only set this to pin the API to a
# DIFFERENT origin than the one serving the UI (e.g. `npm run dev` against a remote server).
# VITE_API_BASE_URL=http://localhost:8092/api/v1

# Parallel uploads on the /uploads screen. 1..8; anything else falls back to the default of 3.
# VITE_UPLOAD_CONCURRENCY=3
