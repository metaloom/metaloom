<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.metaloom.loom.service</groupId>
		<artifactId>loom-services</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>loom-service-graphstore</artifactId>
	<name>MetaLoom // Loom :: Service :: Graph Store</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Override with -Dgraphstore.excluded.groups= to run the benchmark. -->
		<graphstore.excluded.groups>graphbench</graphstore.excluded.groups>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.metaloom.loom.shared</groupId>
			<artifactId>loom-api</artifactId>
		</dependency>

		<!--
			The graph engine. It is an index backend, not a system of record: everything it holds is
			projected from the link tables and can be rebuilt from them.
		-->
		<dependency>
			<groupId>io.metaloom.graph</groupId>
			<artifactId>graph-storage-ffm-poc</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- The differential check runs the real SQL against a real Postgres; see AssetGraphDifferentialTest. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						The differential check and the benchmark both need a live Postgres. The differential check
						skips cleanly without one and is cheap enough to belong in a normal build; the benchmark
						builds a 400,000 edge graph row by row and takes minutes, so it is opt-in by name only.
					-->
					<excludedGroups>${graphstore.excluded.groups}</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
