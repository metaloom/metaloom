<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.metaloom.loom.container</groupId>
        <artifactId>loom-containers</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>loom-container-server</artifactId>
    <name>MetaLoom // Loom :: Container :: Server</name>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.metaloom.loom</groupId>
            <artifactId>loom-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>loom-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>io.metaloom.loom.server.cli.Loom</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- Run shade goal on package phase -->
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>
                                        io.metaloom.loom.container.server.LoomServerRunner</mainClass>
                                </transformer>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Build a GraalVM/SubstrateVM native image of the shaded server jar.

            Activate with: mvn -Pnative package
            Requires GraalVM with native-image installed (e.g. /opt/jvm/graalvm-25).
            Set JAVA_HOME=/opt/jvm/graalvm-25 (or GRAALVM_HOME) before running Maven.
        -->
        <profile>
            <id>native</id>
            <properties>
                <native.image.name>loom-server</native.image.name>
                <native.maven.plugin.version>0.10.6</native.maven.plugin.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.image.name}</imageName>
                            <mainClass>io.metaloom.loom.container.server.LoomServerRunner</mainClass>
                            <classpath>
                                <param>${project.build.directory}/loom-server.jar</param>
                            </classpath>
                            <fallback>false</fallback>
                            <verbose>true</verbose>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>--enable-url-protocols=http,https</buildArg>
                                <buildArg>--initialize-at-build-time=org.slf4j,ch.qos.logback,org.jooq,com.fasterxml.jackson,org.yaml.snakeyaml,org.apache.commons.logging</buildArg>
                                <!--
                                    The OpenAI SDK (used by the chat agent) is written in Kotlin
                                    and pulls in jackson-module-kotlin. jOOQ holds a static
                                    ObjectMapper (Convert.ConvertAll) that picks that module up, so
                                    Kotlin objects - KotlinInstantiators, and the SynchronizedLazyImpl
                                    behind a `lazy` field in the module's converters - land in the
                                    build-time initialized image heap. The Kotlin runtime therefore
                                    has to be build-time initialized too, otherwise the build fails
                                    with "object ... found in the image heap [but] marked for
                                    initialization at image run time".
                                -->
                                <buildArg>--initialize-at-build-time=kotlin</buildArg>
                                <!--
                                    Netty (used by Vert.x) instantiates direct ByteBuffers /
                                    native MemorySegments during class init. Defer netty
                                    initialization to runtime so these objects do not leak
                                    into the image heap.
                                -->
                                <buildArg>--initialize-at-run-time=io.netty</buildArg>
                                <!--
                                    c3p0 / mchange-commons reflection + dynamic-proxy metadata.
                                    Files live in src/main/resources/META-INF/native-image/io.metaloom.loom/loom-server/
                                -->
                                <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/META-INF/native-image/io.metaloom.loom/loom-server</buildArg>
                                <buildArg>-J-Xmx6g</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
