FROM eclipse-temurin:25-jre-alpine

ENV LOOM_AUTH_KEYSTORE_PATH=/keystore/keystore.jks
ENV LOOM_BINARY_DIR=/uploads
ENV LOOM_TEMP_DIR=/tmp
ENV HOME=/loom
# The agent memory bank is opt-in on a real server, but the demo seeds notes and shows the
# Memory screen — without this the endpoints are not even registered and the screen is empty.
ENV LOOM_AGENT_MEMORY_ENABLED=true
# Both index backends are off by default on a real server, but with neither bound the search
# index admin screen has nothing to show but three disabled rows. Both are local Lucene
# directories under the writable /loom, need no external service, and fall back to a no-op
# implementation if the directory cannot be opened — so switching them on cannot fail boot.
# The index is not on a volume, so it is lost when the container is replaced; that is harmless
# and arguably useful here, because both are declared rebuildable caches and the screen's own
# Reindex button is the repair.
ENV LOOM_VECTOR_INDEX_PROVIDER=lucene
ENV LOOM_SIMILARITY_ENABLED=true
# Semantic search stays off: it needs an embeddings host the demo container cannot reach, and a
# row that reports "disabled, and here is why" is a more honest demo than one that errors.
ENV JAVA_TOOL_OPTIONS="-Xms512m -Xmx512m"

EXPOSE 8092
EXPOSE 8091

USER root
RUN adduser -D -u 1000 -G root -h /loom loom && \
    mkdir /uploads   && chown 1000:0 /uploads  -R && chmod 770 /uploads  && \
    mkdir /plugins   && chown 1000:0 /plugins  -R && chmod 770 /plugins  && \
    mkdir /keystore  && chown 1000:0 /keystore -R && chmod 770 /keystore && \
    mkdir /config    && chown 1000:0 /config   -R && chmod 770 /config && ln -s /config /loom/config && \
    mkdir /loom/data && \
    chown 1000:0 /loom -R && \
    chmod 770 /loom -R
ADD --chown=1000:0 ./loom/containers/demo/target/loom-demo.jar /loom/loom.jar
ADD --chown=1000:0 ./loom-ui/build /loom/ui

USER loom
WORKDIR /loom
VOLUME /uploads
VOLUME /plugins
VOLUME /keystore
VOLUME /config

# logback.default.xml ships inside the jar, but logback only auto-loads a file named
# logback.xml, so without this it falls back to BasicConfigurator - root at DEBUG -
# and the container logs every jOOQ statement it executes.
CMD [ "java", "-Djna.tmpdir=/tmp/.jna", "-Duser.dir=/loom", "-Dlogback.configurationFile=logback.default.xml", "-jar" , "loom.jar"]
