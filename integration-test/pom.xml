<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.metaloom.loom.test</groupId>
    <artifactId>loom-integration-test</artifactId>

    <name>MetaLoom // Integration Test</name>

    <parent>
        <groupId>io.metaloom</groupId>
        <artifactId>metaloom-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dagger.version>2.45</dagger.version>
        <loom.nexus.version>1.0.0-SNAPSHOT</loom.nexus.version>
        <loom.cortex.version>1.0.0-SNAPSHOT</loom.cortex.version>
        <loom.client.version>1.0.0-SNAPSHOT</loom.client.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.metaloom</groupId>
                <artifactId>bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <dependencies>
        <dependency>
            <groupId>io.metaloom.loom.container</groupId>
            <artifactId>loom-container-server</artifactId>
            <version>${loom.nexus.version}</version>
        </dependency>
        <!--
    <dependency>
      <groupId>io.metaloom.loom.client</groupId>
      <artifactId>loom-client-grpc</artifactId>
      <version>${loom.client.version}</version>
    </dependency>
    -->
        <dependency>
            <groupId>io.metaloom.loom.client</groupId>
            <artifactId>loom-client-rest</artifactId>
            <version>${loom.client.version}</version>
        </dependency>
        <!-- Drives the CLI in-process so the command surface is covered end to end. -->
        <dependency>
            <groupId>io.metaloom.cli</groupId>
            <artifactId>metaloom-cli</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.metaloom.loom.shared</groupId>
            <artifactId>loom-rest-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-cli</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <!-- The Dagger component lives in cortex-cli but half its modules
             (CortexClientModule, CortexMediaModule, ...) live in cortex-core, so a
             module that constructs a Cortex needs both on the classpath. It does not
             arrive transitively. -->
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-core</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-pipeline-core</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-hash-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-s3-source-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-s3-sink-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-s3-common</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <!-- Processing nodes exercised end-to-end by the *NodeIntegrationTest suite. -->
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-consistency-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-tika-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-quality-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-scene-detection-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-thumbnail-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-fingerprint-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-facedetect-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-ocr-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-vlm-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-whisper-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-tts-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-sentiment-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-script-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-depthmap-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-scene-layout-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-dominant-color-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-image-generation-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>io.metaloom.cortex</groupId>
            <artifactId>cortex-watermark-node</artifactId>
            <version>${loom.cortex.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!--Test-->
        <!-- Mock OpenAI-compatible LLM server + the genai-utils client it is driven through. -->
        <dependency>
            <groupId>io.metaloom.utils</groupId>
            <artifactId>genai-utils-mock-llm-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.metaloom.utils</groupId>
            <artifactId>genai-utils</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.metaloom.loom.test</groupId>
            <artifactId>loom-test-env</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.metaloom.loom</groupId>
            <artifactId>loom-fixture</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Container based integration tests. These run the published images
             rather than booting Loom and Cortex in this JVM, so they exercise the
             Containerfiles, the packaged jars and the env-var configuration path
             that a real deployment uses. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.dagger</groupId>
                            <artifactId>dagger-compiler</artifactId>
                            <version>${dagger.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>